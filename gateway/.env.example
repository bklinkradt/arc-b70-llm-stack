# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Public hostname; an A record for it must point at the home IP (see ddns/).
DOMAIN=llm.example.com
# Let's Encrypt account contact (expiry warnings).
ACME_EMAIL=you@example.com

# Admin key for LiteLLM: creates and revokes user keys. Never hand it out.
# LiteLLM requires the sk- prefix.
LITELLM_MASTER_KEY=sk-change-me
# Encrypts secrets in the database; never change it once keys exist.
LITELLM_SALT_KEY=change-me
# Password for the admin UI (user "admin"), LAN or localhost only.
LITELLM_UI_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
